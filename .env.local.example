# Copie este arquivo para .env.local e preencha os valores
# (ou rode `vercel env pull .env.local` se o projeto estiver linkado na Vercel)

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor; usada pelas rotas /api do admin. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Umami (métricas do painel) — opcional
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
